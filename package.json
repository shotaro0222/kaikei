{
  "name": "kaikei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "個人事業主向け会計ソフト（Cloudflare Workers + D1 + R2）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply kaikei-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kaikei-db --remote",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "postal-mime": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
